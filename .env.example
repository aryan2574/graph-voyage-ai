# Groq API Key (for LLM)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (recommended: openai/gpt-oss-120b)
# Available models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# AviationStack API Key (for flight search)
# Get it from: https://aviationstack.com/product
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Tavily API Key (for web search)
# Get it from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeather API Key (for weather data)
# Get it from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# DATABASE CONFIGURATION

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
# Local: postgresql://postgres:password@localhost:5432/travel_db
# Render: (provided by Render dashboard)
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db

# APPLICATION SETTINGS

# Default origin airport IATA code (e.g., JFK, LHR, DAC)
DEFAULT_ORIGIN_IATA=JFK

# Environment (development, production)
ENVIRONMENT=development

# EVALUATION & MONITORING (Optional)

# Sample rate for request evaluation (0.0 to 1.0)
# 1.0 = 100% (all requests evaluated)
# 0.1 = 10% (recommended for production)
EVAL_SAMPLE_RATE=1.0

# Rolling window size for metrics calculation
EVAL_ROLLING_WINDOW=100

# LANGSMITH TRACING (Optional)
# Leave commented out if not using LangSmith

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=your_project_name
