# Secret Template: Copy this to 01-secret.yaml and fill in your actual values

apiVersion: v1
kind: Secret
metadata:
  name: graphvoyageai-secrets
  namespace: graphvoyage
type: Opaque
stringData:
  # Database credentials
  postgres-password: YOUR_POSTGRES_PASSWORD_HERE
  database-url: postgresql://travel_user:YOUR_PASSWORD@postgres-service:5432/travel_db?sslmode=disable
  
  # API Keys - Replace with your actual keys
  groq-api-key: YOUR_GROQ_API_KEY_HERE
  aviationstack-api-key: YOUR_AVIATIONSTACK_API_KEY_HERE
  tavily-api-key: YOUR_TAVILY_API_KEY_HERE
  openweather-api-key: YOUR_OPENWEATHER_API_KEY_HERE
  langsmith-api-key: YOUR_LANGSMITH_API_KEY_HERE

---
# How to use:
# 1. Copy this file: cp k8s/01-secret.yaml.template k8s/01-secret.yaml
# 2. Edit k8s/01-secret.yaml and replace all YOUR_*_HERE with actual values
# 3. Apply: kubectl apply -f k8s/01-secret.yaml
# 4. Never commit k8s/01-secret.yaml (it's in .gitignore)

# Production: Use external secret management
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
# - Google Secret Manager
